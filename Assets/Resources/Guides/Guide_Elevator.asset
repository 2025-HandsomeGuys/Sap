    frames: []
    framesPerSecond: 8
    titleKey: ui_guide_elevator_find_title
    titleFallback: "\uC815\uB958\uC7A5 \uCC3E\uAE30"
    bodyKey: ui_guide_elevator_find_body
    bodyFallback: "\uCE35\uB9C8\uB2E4 \uC5D8\uB9AC\uBCA0\uC774\uD130\uAC00 \uD558\uB098\uC529 \uC788\uACE0, \uC704\uCE58\uB294 \uCE35\uB9C8\uB2E4 \uC88C\uC6B0\uB85C \uB2EC\uB77C\uC9D1\uB2C8\uB2E4.\n\uC9C0\uB3C4\uC5D0 \uD45C\uC2DC\uB41C \uB9C8\uCEE4\uB97C \uB530\uB77C\uAC00\uC138\uC694."
  - mediaType: 1
    image: {fileID: 0}
    video: {fileID: 0}
    frames: []
    framesPerSecond: 8
    titleKey: ui_guide_elevator_unlock_title
    titleFallback: "\uC815\uB958\uC7A5 \uD574\uAE08"
    bodyKey: ui_guide_elevator_unlock_body
    bodyFallback: "\uD55C \uBC88 \uC9C1\uC811 \uAC78\uC5B4\uAC00 \uBCF8 \uC815\uB958\uC7A5\uB9CC \uB2E4\uC74C\uBD80\uD130 \uBC14\uB85C \uB0B4\uB824\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uAE4A\uC740 \uCE35\uC740 \uACB0\uAD6D \uD55C \uBC88\uC740 \uAC78\uC5B4\uC11C \uB3C4\uB2EC\uD574\uC57C \uD569\uB2C8\uB2E4."
  - mediaType: 1
    image: {fileID: 0}
    video: {fileID: 0}
    frames: []
    framesPerSecond: 8
    titleKey: ui_guide_elevator_exit_title
    titleFallback: "\uC9C0\uC0C1\uC73C\uB85C"
    bodyKey: ui_guide_elevator_exit_body
    bodyFallback: "\uC5D8\uB9AC\uBCA0\uC774\uD130\uC5D0\uC11C \uC9C0\uC0C1\uC73C\uB85C \uB098\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\uCC9C\uC7A5 \uAD6C\uBA4D\uC5D0\uC11C \uC0C8\uC5B4\uB4DC\uB294 \uBE5B\uAE30\uB465 \uC544\uB798\uC5D0\uC11C E \uD0A4\uB85C\uB3C4 \uB098\uAC08 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
