    titleFallback: "\uC8FC\uC2DD"
    bodyKey: ui_guide_market_stock_body
    bodyFallback: "\uB274\uC2A4\uC5D0 \uB530\uB77C \uC8FC\uAC00\uAC00 \uC6C0\uC9C1\uC785\uB2C8\uB2E4.
      \uCC0C\uB77C\uC2DC\uAC00 \uBA3C\uC800 \uB3CC\uACE0 \uACF5\uC2DD \uBC1C\uD45C\uAC00
      \uB4A4\uB530\uB974\uB294 \uC885\uBAA9\uB3C4 \uC788\uC2B5\uB2C8\uB2E4.\n\uCC44\uAD11
      \uB808\uBCA8\uC744 \uC62C\uB9AC\uBA74 \uB354 \uB192\uC740 \uB4F1\uAE09\uC758
      \uC885\uBAA9\uC774 \uC0C1\uC7A5\uB429\uB2C8\uB2E4."
