    titleKey: ui_guide_market_risk_title
    titleFallback: "\uCCAD\uC0B0\uACFC \uC0C1\uC7A5\uD3D0\uC9C0"
    bodyKey: ui_guide_market_risk_body
    bodyFallback: "\uB808\uBC84\uB9AC\uC9C0\uB97C \uC62C\uB9AC\uBA74 \uBCF4\uC0C1\uB3C4
      \uD06C\uC9C0\uB9CC \uB9C8\uC9C4\uC744 \uD1B5\uC9F8\uB85C \uB0A0\uB9B4 \uD655\uB960\uB3C4
      \uD568\uAED8 \uC624\uB985\uB2C8\uB2E4.\n\uCF54\uC778\uC774 \u2212100%\uB97C
      \uCC0D\uC73C\uBA74 \uC0C1\uC7A5\uD3D0\uC9C0\uB418\uACE0 \uC0C8 \uCF54\uC778\uC73C\uB85C
      \uAD50\uCCB4\uB429\uB2C8\uB2E4."
